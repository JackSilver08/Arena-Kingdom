{
  "name": "arena-kingdom",
  "private": true,
  "version": "0.2.0",
  "description": "Arena Kingdom - lightweight 2D real-time strategy arena",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "predev": "npm run build:shared",
    "dev": "concurrently -k -n shared,client,server -c gray,blue,green \"npm:dev:shared\" \"npm:dev:client\" \"npm:dev:server\"",
    "dev:shared": "npm --workspace shared run dev",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "build:shared": "npm run build:shared",
    "build:client": "npm run build:client",
    "build:server": "npm run build:server",
    "start": "npm --workspace server run start",
    "test": "npm --workspace shared run test",
    "typecheck": "npm run build:shared && npm --workspace client run typecheck && npm --workspace server run typecheck",
    "qa:static": "node tools/check-documentary.mjs",
    "check:bundle": "node tools/check-bundle.mjs",
    "qa": "npm run qa:static && npm run typecheck && npm test && npm run build && npm run check:bundle",
    "simulate": "npm --workspace shared run simulate --",
    "simulate:balance": "npm --workspace shared run simulate:balance --",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
