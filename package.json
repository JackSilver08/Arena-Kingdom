{
  "name": "arena-kingdom",
  "private": true,
  "version": "0.1.0",
  "description": "Arena Kingdom - lightweight 2D real-time strategy arena",
  "workspaces": ["client", "server", "shared"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "build:shared": "npm --workspace shared run build",
    "build:client": "npm --workspace client run build",
    "build:server": "npm --workspace server run build",
    "test": "npm run build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
